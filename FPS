task.spawn(function()

    while task.wait(60) do

        if AlreadyKicked then
            return
        end

        local rank = GetRank()
        local runsLeft = GetRunsLeft()
        local inInstance = IsInInstance()

        if rank >= 16
            and runsLeft == 10
            and not inInstance
        then

            Log(
                "TIME TRIAL CHECK START",
                "Rank =", rank,
                "Runs =", runsLeft,
                "Instance =", inInstance
            )

            local passed = VerifyCondition(
                600, -- 10 phút
                function()

                    return GetRank() >= 16
                        and GetRunsLeft() == 10
                        and not IsInInstance()

                end
            )

            if passed then

                Log(
                    "TIME TRIAL VERIFIED",
                    "10 phút không vào Event",
                    "=> Load config"
                )

                KickPlayer("Load config")

                return
            end

            Log("TIME TRIAL CANCELLED")

        end
    end

end)
