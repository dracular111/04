task.wait(300)
-- 🔥 ANTI DUPLICATE
if _G.TIME_TRIAL_MONITOR then return end
_G.TIME_TRIAL_MONITOR = true

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local Save = require(ReplicatedStorage.Library.Client.Save)

local InstancingCmds
pcall(function()
    InstancingCmds = require(
        ReplicatedStorage.Library.Client.InstancingCmds
    )
end)

-- ==== GET RUNS ====
local function getRunsLeft()
    local ok, data = pcall(Save.Get)
    local used = (ok and data and data.TimeTrialStats and data.TimeTrialStats.DailyRuns) or 0
    return 10 - used
end

-- ==== CHECK INSTANCE / EVENT ====
local function IsInInstance()
    local inInstance = false

    if InstancingCmds then
        pcall(function()
            inInstance = InstancingCmds.IsInInstance()
        end)
    end

    return inInstance
end

-- ==== MONITOR ====
task.spawn(function()
    while true do
        task.wait(30)

        local left = getRunsLeft()
        print("Monitor RunsLeft:", left)

        if left <= 0 then
            warn("⚠️ Phát hiện hết lượt → chờ xác nhận...")

            task.wait(10)

            if getRunsLeft() <= 0 then
                warn("❌ Xác nhận hết lượt → đợi 2 phút rồi kiểm tra")

                task.wait(120)

                -- Chỉ kick nếu vẫn ở map ngoài
                if not IsInInstance() then
                    warn("🚪 Vẫn ở map ngoài → Kick")
                    player:Kick("Hết lượt Time Trial → đổi config")
                else
                    warn("✅ Đang ở Event/Instance → Không kick")
                end

                return
            else
                warn("✅ False alarm → vẫn còn lượt")
            end
        end
    end
end)
