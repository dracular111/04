repeat task.wait() until game:IsLoaded()

local Player = game.Players.LocalPlayer
local Save = require(game.ReplicatedStorage.Library.Client.Save)

local LastRank = nil

while true do
    local ok, Data = pcall(Save.Get)

    if ok and Data then
        local Rank = Data.Rank or Data.Ranks or 0

        if Rank ~= LastRank then
            LastRank = Rank
            print("Rank:", Rank)
        end

        if Rank >= 16 then
            Player:Kick("Rank >=16 -> đổi Config2")
            break
        end
    end

    task.wait(5)
end
