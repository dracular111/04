repeat task.wait() until game:IsLoaded()

local Player = game.Players.LocalPlayer
local Save = require(game.ReplicatedStorage.Library.Client.Save)

local function GetData()
    for i = 1, 10 do
        local ok, result = pcall(Save.Get)

        if ok and result then
            return result
        end

        task.wait(1)
    end

    return nil
end

local Data = GetData()

if not Data then
    Player:Kick("Không load được data")
    return
end

while true do
    local ok, NewData = pcall(Save.Get)

    if ok and NewData then
        Data = NewData

        local Rank = Data.Rank or Data.Ranks or 0
        print("Rank:", Rank)

        if Rank >= 16 then
            Player:Kick("Rank >=16 -> đổi Config2")
            break
        end
    end

    task.wait(180) -- kiểm tra lại mỗi 3 phút
end
