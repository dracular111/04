task.spawn(function()

    while task.wait(60) do

        if AlreadyKicked then
            return
        end

        local rank = GetRank()
        local runsLeft = GetRunsLeft()
        local inInstance = IsInInstance()

        if rank >= 16
            and runsLeft == 10
            and inInstance
        then

            Log(
                "EVENT DETECTED",
                "Rank =", rank,
                "Runs =", runsLeft
            )

            local passed = VerifyCondition(
                600, -- 10 phút
                function()

                    return GetRank() >= 16
                        and GetRunsLeft() == 10
                        and IsInInstance()

                end
            )

            if passed then

                Log(
                    "EVENT VERIFIED",
                    "10 phút vẫn ở Instance",
                    "=> Load config"
                )

                KickPlayer("Load config")

                return
            end

            Log("EVENT CANCELLED")

        end
    end

end)
