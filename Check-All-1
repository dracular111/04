task.spawn(function()

    while task.wait(60) do

        if AlreadyKicked then
            return
        end

        local rank = GetRank()
        local runsLeft = GetRunsLeft()

        if rank >= 16 and runsLeft == 10 then

            Log(
                "TT WATCH START",
                "Rank =", rank,
                "Runs =", runsLeft
            )

            local passed = VerifyCondition(
                900, -- 15 phút
                function()
                    return GetRank() >= 16
                        and GetRunsLeft() == 10
                end
            )

            if passed then

                Log(
                    "TT WATCH VERIFIED",
                    "15 phút vẫn còn 10/10",
                    "=> Load config"
                )

                KickPlayer("Load config")
                return
            end

            Log("TT WATCH CANCELLED")

        end
    end

end)
